# Скопируй в .env и заполни. .env в git не попадает — никогда.

# ===== Ozon Seller API =====
# Получить: https://seller.ozon.ru → Настройки → API ключи
# Заголовки запроса: Client-Id + Api-Key
OZON_CLIENT_ID=
OZON_API_KEY=

# ===== Telegram =====
# Бот создаётся у @BotFather. Токеном владеет ТОЛЬКО tg-bridge:
# два polling-процесса на один токен = 409 Conflict.
TG_BOT_TOKEN=
# id группового чата команды, с префиксом -100
TG_TEAM_CHAT=-100

# ===== Реквизиты ИП (нужны скиллу marketplaces-tax-ru) =====
USER_FULL_NAME=
USER_LAST_NAME=
USER_FIRST_NAME=
USER_MIDDLE_NAME=
USER_INN=
USER_OKPO=
USER_OKTMO=
# Код вашей налоговой инспекции. Дефолта нет намеренно: чужой код = декларация уйдёт не туда.
USER_FNS_CODE=
USER_TAX_OBJECT=Доходы
USER_TAX_RATE_PERCENT=1
# Код льготы для пониженной ставки: 3462010 + статья/пункт/подпункт РЕГИОНАЛЬНОГО
# закона по 4 цифры с ведущими нулями, напр. 3462010/000100010001
USER_TAX_RATE_LAW_CODE=
USER_OZON_BANK_NAME=
USER_OZON_BANK_ACCOUNT_1=
USER_OZON_BANK_ACCOUNT_2=
# Агентский договор с Ozon — попадает в КУДиР
OZON_AGENCY_CONTRACT_NUMBER=
OZON_AGENCY_CONTRACT_DATE=

# ===== Опционально =====
# Прокси для скрейпера конкурентов. ТОЛЬКО на сервере, если исходящий
# трафик заворачивается прозрачно: libcurl мимо iptables-редиректа не идёт.
# На домашней машине с прямым IP — не задавать.
# OZON_SCOUT_PROXY=http://127.0.0.1:7890

# Сессионная кука mpstats.io для tools/mpstats.py
# MPSTATS_COOKIE=

# Банковская выписка по стандарту 1С:DirectBank
# DIRECTBANK_URL=
# DIRECTBANK_LOGIN=
# DIRECTBANK_PASSWORD=
# DIRECTBANK_CUSTOMER=
# DIRECTBANK_APIVER=2.3

# ===== Wildberries Seller API (если торгуете и там) =====
# Получить: https://seller.wildberries.ru → Настройки → Доступ к API
WB_API_TOKEN=
