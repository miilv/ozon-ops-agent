{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python3:*)",
      "Bash(sqlite3:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(curl -s https://api-seller.ozon.ru*)",
      "Edit(state/**)",
      "Edit(docs/**)",
      "Edit(memory/**)",
      "Edit(/tmp/**)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/stop_check.py"
          }
        ]
      }
    ]
  }
}